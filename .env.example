# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Share secrets via 1Password or `vercel env pull`.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database / Supabase ─────────────────────────────────────────────────────
# DATABASE_URL is the Postgres connection string from Supabase project settings → Database.
# Use the *transaction* pooler URL for serverless (Vercel).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct (non-pooler, port 5432) connection — needed by drizzle-kit push/studio.
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Public Supabase keys (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — server-only, never exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Signing secret for the Supabase Auth "Send Email" hook (Auth → Hooks).
# Format: v1,whsec_<base64>. Lets branded verify/reset emails go via Resend.
SUPABASE_AUTH_HOOK_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Aarna <hello@shopaarna.in>"

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Local dev uses rzp_test_* keys. On Vercel Production, set these SAME variable
# names to the rzp_live_* values (there are no separate *_LIVE_* vars in code —
# the environment decides which mode runs).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret — generated per mode in Razorpay → Settings → Webhooks.
# The live one can only be created after the production URL exists.
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Delhivery ───────────────────────────────────────────────────────────────
# API token from the Delhivery panel (Settings → API) once KYC is approved.
DELHIVERY_API_TOKEN=
# Base URL: https://track.delhivery.com (prod) | https://staging-express.delhivery.com (staging)
DELHIVERY_API_BASE_URL=https://track.delhivery.com
# Registered pickup/warehouse name + pincode configured in the Delhivery panel.
DELHIVERY_PICKUP_NAME=
DELHIVERY_PICKUP_PINCODE=
# Shared secret appended to the webhook push URL (?token=...) and matched server-side.
DELHIVERY_WEBHOOK_TOKEN=

# ─── WhatsApp BSP (Interakt) ─────────────────────────────────────────────────
# API key from Interakt → Developer Settings (used as `Authorization: Basic <key>`).
WHATSAPP_API_BASE_URL=https://api.interakt.ai/v1/public
WHATSAPP_API_KEY=
# Optional shared secret to verify Interakt delivery-receipt webhooks.
WHATSAPP_WEBHOOK_SECRET=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Cron ────────────────────────────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on scheduled
# (vercel.json) requests. Any long random string — e.g. `openssl rand -hex 32`.
CRON_SECRET=
